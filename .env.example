# demo accepts ONLY the exact bundled synthetic images; it is not AI inference.
PROVIDER=demo
# To enable real image analysis, use PROVIDER=openai and add your private key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional shared access code, entered in the app; never put an API key here.
REVIEW_ACCESS_TOKEN=
AI_TIMEOUT_SECONDS=12
MAX_CONCURRENT_REQUESTS=3
REQUESTS_PER_MINUTE=180
# Local Vite development origin. Production requests use the same origin.
DEV_ORIGIN=http://localhost:5173
